<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wolfox.gps">

    <!-- شبكة -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- موقع — للعرض داخل الأداة فقط، ليس للـ mock system -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- خدمة الخلفية للأذان -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- تخزين — للـ API 28 وأقل -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:label="WolFox GPS"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <!-- LSPosed Module Metadata -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="WolFox GPS v4 — LSPatch/LSPosed module" />
        <meta-data android:name="xposedminversion" android:value="93" />

        <!-- خدمة الأذان في الخلفية -->
        <service
            android:name=".service.AzanService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- استعادة الخدمة بعد إعادة التشغيل -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
