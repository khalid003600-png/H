+- (void)identifierStateChanged:(__unused NSNotification *)notification {
+    if (!NSThread.isMainThread) {
+        dispatch_async(dispatch_get_main_queue(), ^{ [self identifierStateChanged:nil]; });
+        return;
+    }
+    UITextField *tf = objc_getAssociatedObject(self, "_id_tf_page");
+    if (tf) tf.text = [WolFoxProStore shared].activeIdentifierUUID ?: @"";
+    UILabel *status = objc_getAssociatedObject(self, "_id_status_label");
+    BOOL active = [WolFoxProStore shared].validatedActiveIdentifier != nil;
+    if (status) {
+        status.text = active ? @"حالة تزييف المعرّفات: مفعّل" : @"حالة تزييف المعرّفات: متوقف";
+        status.textColor = active ? [WolFoxProTheme success] : [WolFoxProTheme textSecondary];
+    }
+    [self refreshSpoofHeaderStatus];
+    if (_activePage == 1) [self switchPage:1];
+}
